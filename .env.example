DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─────────────────────────────────────────────────────────────────────────────
# StockPilot AI
# ─────────────────────────────────────────────────────────────────────────────

# Run mode: "selfhost" (default — all features unlocked, no billing) or "cloud"
# (Stripe billing + subscription tiers active). See docs/stockpilot/ROADMAP.md.
STOCKPILOT_MODE=selfhost

# Market data providers (optional). Yahoo Finance works with no key on all tiers.
# Alpha Vantage / Polygon unlock for self-host, bring-your-own-keys, and
# subscription tiers (free cloud tier is Yahoo-only).
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=

# Charles Schwab read-only broker OAuth (optional)
# SCHWAB_CLIENT_ID=
# SCHWAB_CLIENT_SECRET=
# SCHWAB_REDIRECT_URI=http://localhost:3100/api/broker/schwab/callback

# Stripe billing — cloud mode only (Plan 5). Leave unset in self-host.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...           # from `stripe listen` or the dashboard
# STRIPE_PRICE_ID=price_...                 # the subscription price to sell
# APP_BASE_URL=http://localhost:5173        # used for Stripe success/cancel/return URLs

# ─── Cloud deployment (Plan 6 — Vercel + Supabase) ──────────────────────────
# Required when deploying to Vercel. Set these in the Vercel dashboard under
# Project → Settings → Environment Variables.

# Deployment mode — "authenticated" enforces login for all routes
# PAPERCLIP_DEPLOYMENT_MODE=authenticated

# Supabase PostgreSQL connection string (Transaction pooler, port 6543)
# DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Public URL of your Vercel deployment (used by better-auth for cookie domains)
# PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://<your-project>.vercel.app

# Auth secret — generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Disable WebSockets (not supported in Vercel serverless functions)
# PAPERCLIP_DISABLE_LIVE_EVENTS_WS=true

# Supabase Storage (S3-compatible) — values from Supabase dashboard → Storage → S3 keys
# PAPERCLIP_STORAGE_PROVIDER=s3
# PAPERCLIP_STORAGE_S3_BUCKET=stockpilot
# PAPERCLIP_STORAGE_S3_REGION=us-east-1
# PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
# PAPERCLIP_STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# AWS_ACCESS_KEY_ID=<supabase-s3-access-key>
# AWS_SECRET_ACCESS_KEY=<supabase-s3-secret>
